# ============================================================
#  RPS — Variables d'environnement (modèle)
#  Copier en .env.local pour le développement.
#  En production : définir ces valeurs dans Vercel (Settings > Environment Variables).
#  NE JAMAIS committer .env.local ni les vraies clés.
# ============================================================

# --- Supabase (Project Settings > API) ---
# Projet cible : yrzpjacgoqdopooalpsb
NEXT_PUBLIC_SUPABASE_URL=https://yrzpjacgoqdopooalpsb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...           # clé publique (anon), côté client
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # clé secrète, UNIQUEMENT côté serveur (import, cron)

# --- Base de données (pour migrations / outils CLI) ---
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.yrzpjacgoqdopooalpsb.supabase.co:5432/postgres

# --- Application ---
NEXT_PUBLIC_APP_NAME=RPS — Pilotage réseau
NEXT_PUBLIC_DEVISE=FCFA
TZ=Africa/Niamey

# --- Passerelle SMS (phase ultérieure — relances) ---
# Renseigner quand le module relances sera branché.
SMS_PROVIDER=                                   # ex. nom de l'agrégateur/opérateur
SMS_API_KEY=
SMS_SENDER_ID=RPS

# --- Sécurité ---
# Secret pour sécuriser l'endpoint appelé par Vercel Cron (relances).
CRON_SECRET=remplacer-par-une-chaine-aleatoire-longue
