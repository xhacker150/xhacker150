# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # clé publiable (Project Settings > API Keys) : navigateur et session
SUPABASE_SECRET_KEYS=sb_secret_...                        # clé(s) secrète(s) "nouvelle,ancienne" : serveur uniquement (pont, cron), jamais exposée
# Anciennes clés JWT (anon / service_role) : encore acceptées en repli, à retirer une fois désactivées par le DG
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- API du pont (RPS-SERVER -> CRM) : une ou plusieurs clés (rotation à chaud : "nouvelle,ancienne") ---
PONT_API_KEYS=changez-moi-cle-longue-aleatoire
NEXT_PUBLIC_APP_URL=https://crm-creances.vercel.app

# --- Vercel Cron (recalcul nocturne, récapitulatif) ---
CRON_SECRET=changez-moi-autre-cle-aleatoire

# --- E-mails (Resend, patron repris du workflow RPS) : alertes de santé et récapitulatif ; facultatif ---
RESEND_API_KEY=
EMAIL_EXPEDITEUR="RPS CRM Créances <recouvrement@votre-domaine.com>"
