# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # clé anon / publishable
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # clé service_role (serveur uniquement, jamais exposée au navigateur)

# --- Vercel Cron (Settings > Environment Variables) ---
# Vercel envoie automatiquement "Authorization: Bearer $CRON_SECRET" sur /api/cron/relances
CRON_SECRET=change-me-long-random-string

# --- Envoi des relances automatiques par e-mail (optionnel, via Resend) ---
# Sans clé, les relances e-mail restent "planifiées" et sont traitées manuellement depuis l'agenda.
RESEND_API_KEY=
EMAIL_EXPEDITEUR="Recouvrement <recouvrement@votre-domaine.com>"
