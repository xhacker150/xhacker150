# ── Base de données ─────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=rps_solaire
DB_USER=rps_solaire
DB_PASSWORD=change_me_in_prod

# ── Serveur web ─────────────────────────────────────────────────
PORT=3100
NODE_ENV=production
# Au moins 32 caractères aléatoires : openssl rand -hex 32
JWT_SECRET=
SESSION_HEURES=12
# true en HTTPS (défaut en production). false uniquement pour un essai local en HTTP.
COOKIE_SECURE=true
# true derrière un reverse proxy (nginx, Traefik…)
TRUST_PROXY=false

# ── API Felicity Solar (fSolar) ─────────────────────────────────
FSOLAR_BASE_URL=https://open-api.felicitysolar.com
FSOLAR_USERNAME=
FSOLAR_PASSWORD=
# Clé RSA publiée dans la doc fSolar (laisser vide pour la valeur par défaut)
FSOLAR_PUBLIC_KEY=
FSOLAR_LANG=en_US
# Où envoyer les paramètres des requêtes GET : both | query | body
FSOLAR_GET_PARAMS=both

# ── Collecte (secondes) ─────────────────────────────────────────
COLLECTE_ACTIVE=true
COLLECTE_INVENTAIRE_SEC=3600
COLLECTE_MESURES_SEC=300
COLLECTE_ENERGIE_SEC=1800
COLLECTE_EVENEMENTS_SEC=900
COLLECTE_VERIFICATION_SEC=60
# Onduleur sans mesure depuis ce délai = hors ligne
HORS_LIGNE_MINUTES=20
# Fuseau des stations (Niger : +01:00)
FUSEAU_DEFAUT=+01:00

# ── Réglages à distance ─────────────────────────────────────────
# Délai avant la relecture de vérification d'une commande
REGLAGES_DELAI_VERIFICATION_SEC=120
# Au-delà, une commande non confirmée passe en « écart » ou « non vérifiée »
REGLAGES_DELAI_ABANDON_MIN=30
